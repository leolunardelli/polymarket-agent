# Environment: development, staging, or production
ENVIRONMENT=development
NODE_ENV=development
PORT=3000

# === Polymarket API Configuration ===
# WARNING: Never commit actual API keys. Use a secure vault in production.
# POLYMARKET_API_KEY=your_api_key_here (set via secure vault, never in code)
# POLYMARKET_PRIVATE_KEY=your_private_key_here (set via secure vault, never in code)
POLYMARKET_CHAIN_ID=137
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com
POLYMARKET_DATA_URL=https://data-api.polymarket.com

# === Database Configuration ===
# Use full connection string with credentials from secure vault
# DATABASE_URL=postgresql://user:password@host:port/database (set via secure vault)
DATABASE_MAX_CONNECTIONS=20
DATABASE_CONNECTION_TIMEOUT=30000
DATABASE_IDLE_TIMEOUT=30000

# === Cache Configuration ===
CACHE_TTL_MS=10000
CACHE_MAX_SIZE=1000

# === Rate Limiting ===
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# === Logging Configuration ===
LOG_LEVEL=INFO
LOG_FORMAT=json

# === Monitoring & Alerting ===
MONITORING_ENABLED=true
PROMETHEUS_PORT=9090
ALERTING_ENABLED=true

# === Security Configuration ===
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
TLS_ENABLED=false
# TLS_CERT_PATH=/path/to/cert.pem (set in production)
# TLS_KEY_PATH=/path/to/key.pem (set in production)
# JWT_SECRET=your_jwt_secret_here (set via secure vault, minimum 32 characters)

# === Feature Flags ===
FEATURE_LIQUIDITY_ANALYSIS=true
FEATURE_SENTIMENT_ANALYSIS=true
FEATURE_AUTOMATED_TRADING=false

# === Legacy Configuration (to be deprecated) ===
# Webhook Configuration
WEBHOOK_ENDPOINT=https://webhook.site/your-webhook-id
SLACK_WEBHOOK=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Portfolio Configuration
MAX_POSITION_SIZE=0.20
MAX_PORTFOLIO_RISK=0.50
MAX_CORRELATION=0.70
MAX_POSITIONS=10

# Risk Management
MAX_DRAWDOWN_THRESHOLD=0.25
MIN_LIQUIDITY=10000

# WebSocket Configuration
WS_ENABLED=true
WS_RECONNECT=true
WS_RECONNECT_INTERVAL=1000
WS_MAX_RECONNECT_ATTEMPTS=10

# Logging File Path (replaced by structured logging)
LOG_FILE=./logs/trading.log
